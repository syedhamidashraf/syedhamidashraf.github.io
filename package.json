{
  "name": "syedhamidashraf.github.io",
  "version": "1.0.0",
  "description": "Personal Portfolio of Syed Hamid Ashraf - Data Engineer",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf public",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:sass": "sass src/styles/main.scss public/assets/css/main.css --style compressed",
    "build:eleventy": "eleventy",
    "watch:sass": "sass src/styles/main.scss public/assets/css/main.css --watch",
    "watch:eleventy": "eleventy --serve",
    "start": "npm run clean && npm-run-all --parallel watch:*",
    "build": "npm run clean && npm-run-all --serial build:sass build:eleventy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedhamidashraf/syedhamidashraf.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/syedhamidashraf/syedhamidashraf.github.io/issues"
  },
  "homepage": "https://github.com/syedhamidashraf/syedhamidashraf.github.io#readme",
  "keywords": [
    "portfolio",
    "data-engineer",
    "data-engineering",
    "11ty",
    "eleventy",
    "static-site-generator",
    "sass",
    "javascript",
    "web-performance",
    "automated-deployment",
    "data-visualization",
    "python",
    "sql"
  ],
  "author": "Syed Hamid Ashraf",
  "license": "ISC",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-fetch": "^5.1.1",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-server-browsersync": "^1.0.2",
    "dotenv": "^17.2.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "luxon": "^3.7.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "sass": "^1.97.3"
  }
}
