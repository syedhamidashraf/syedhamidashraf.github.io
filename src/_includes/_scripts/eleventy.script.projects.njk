{% script %}
const GITHUB_USER = "{{ globalConfig.social.github_username }}";

function formatDate(dateString) {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

async function fetchGithubData() {
  const profileContainer = document.getElementById('github-profile-card');
  const repoContainer = document.getElementById('github-repos');
  if (!GITHUB_USER) return;

  try {
    const [userRes, repoRes] = await Promise.all([
      fetch(`https://api.github.com/users/${GITHUB_USER}`),
      fetch(`https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=6`)
    ]);

    const user = await userRes.json();
    const repos = await repoRes.json();

    if (profileContainer) {
      profileContainer.innerHTML = `
        <div class="github-profile-card">
          <div class="profile-main">
            <div class="avatar-container">
              <img src="${user.avatar_url}" alt="${user.name}" class="profile-avatar">
            </div>
            <div class="profile-info">
              <h2 class="profile-name">${user.name || GITHUB_USER}</h2>
              <p class="profile-handle">@${user.login}</p>
            </div>
          </div>
          <div class="stats-grid">
            <div class="stat-box"><span class="stat-value">90+</span><span class="stat-label">Contributions</span></div>
            <div class="stat-box"><span class="stat-value">60+</span><span class="stat-label">Commits</span></div>
            <div class="stat-box"><span class="stat-value">6+</span><span class="stat-label">Issues & PRs</span></div>
            <div class="stat-box"><span class="stat-value">${new Date(user.created_at).getFullYear()}</span><span class="stat-label">Since</span></div>
          </div>
        </div>
      `;
    }

    if (repoContainer) {
      repoContainer.innerHTML = repos.map(repo => `
        <div class="github-repo">
          <div class="repo-header">
            <h3 class="repo-name"><a href="${repo.html_url}" target="_blank" title="${repo.name}">${repo.name}</a></h3>
            <span class="repo-language">${repo.language || 'Data'}</span>
          </div>
          <p class="repo-description">${repo.description || 'Project development and solutions.'}</p>
          <div class="repo-stats">
            <span class="repo-stat"><span class="icon">⭐</span> ${repo.stargazers_count}</span>
            <span class="repo-stat"><span class="icon">🔀</span> ${repo.forks_count}</span>
          </div>
          <div class="repo-meta">Updated: ${formatDate(repo.updated_at)}</div>
        </div>
      `).join('');
    }
  } catch (e) { console.error(e); }
}
fetchGithubData();
{% endscript %}