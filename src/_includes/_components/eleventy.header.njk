<header class="header" id="header">
    <div class="container">
        <nav class="nav">
            <a href="#hero" class="nav__logo">{{ globalConfig.name | initials }}</a>
            
            <button class="nav__toggle" id="nav-toggle" aria-label="Toggle navigation">
                <span class="hamburger"></span>
            </button>

            <ul class="nav__links" id="nav-menu">
                {% for item in globalConfig.navigation %}
                <li><a href="{{ item.link }}">{{ item.name }}</a></li>
                {% endfor %}
            </ul>
        </nav>
    </div>
</header>

{% include "_scripts/eleventy.script.header.njk" %}